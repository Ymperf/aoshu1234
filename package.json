{
  "name": "math-olympiad-learning-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "packageManager": "npm@11.4.2",
  "scripts": {
    "postinstall": "node scripts/bootstrap/patch-next-build.js",
    "content:import": "python services/content-pipeline/src/cli/main.py",
    "content:generate:ai": "python services/content-pipeline/src/cli/generate_ai_review.py",
    "db:seed": "python scripts/import/import-content-seed.py",
    "demo:chicken-rabbit:tts": "python scripts/media/generate_chicken_rabbit_tts.py",
    "demo:chicken-rabbit:sync": "node scripts/media/sync_chicken_rabbit_pipeline_to_demo.mjs",
    "demo:chicken-rabbit:render": "node scripts/media/render_chicken_rabbit_video.mjs",
    "demo:chicken-rabbit": "powershell -ExecutionPolicy Bypass -File scripts/media/generate-chicken-rabbit-demo.ps1",
    "test:content-import": "node scripts/smoke/content-import-smoke.mjs",
    "db:migration-status:business": "node scripts/db/migration-status.mjs business",
    "db:migration-status:content": "node scripts/db/migration-status.mjs content",
    "db:rollback:business": "node scripts/db/rollback-sqlite-snapshot.mjs business",
    "db:rollback:content": "node scripts/db/rollback-sqlite-snapshot.mjs content",
    "db:export:business": "node scripts/db/export-business.mjs",
    "db:export:content": "node scripts/db/export-content.mjs",
    "db:import:template": "node scripts/db/import-production-template.mjs",
    "db:import:postgres": "node scripts/db/import-postgres-template.mjs",
    "db:import:mysql": "node scripts/db/import-mysql-template.mjs",
    "verify:release": "node scripts/verify/check-release-version.mjs",
    "verify:release:latest": "node -e \"const fs=require('fs');const s=JSON.parse(fs.readFileSync('data/generated/app-state/content-release-state.json','utf8'));if(!s.activeVersionTag) throw new Error('No activeVersionTag'); require('child_process').spawnSync(process.execPath,['scripts/verify/check-release-version.mjs',s.activeVersionTag],{stdio:'inherit'});\"",
    "local:start": "powershell -ExecutionPolicy Bypass -File scripts/local/start-local.ps1",
    "local:stop": "powershell -ExecutionPolicy Bypass -File scripts/local/stop-local.ps1",
    "test:smoke": "npm run build:web",
    "test:smoke:video": "node scripts/smoke/video-batch-smoke.mjs",
    "verify:baseline": "npm run lint && npm run build:web",
    "verify:runtime": "npm run build:web",
    "dev:web": "npm run dev --workspace web",
    "lesson:prepare": "node scripts/lesson/index.mjs prepare",
    "lesson:generate": "node scripts/lesson/index.mjs generate",
    "lesson:render-illustrations": "node scripts/lesson/index.mjs render-illustrations",
    "lesson:assemble": "node scripts/lesson/index.mjs assemble",
    "lesson:validate": "node scripts/lesson/index.mjs validate",
    "lesson:report": "node scripts/lesson/index.mjs report",
    "lesson:build": "node scripts/lesson/index.mjs build",
    "video:batch": "node scripts/media/build_teacher_video_batch.mjs",
    "video:batch:resume": "node scripts/media/build_teacher_video_batch.mjs resume",
    "video:batch:retry": "node scripts/media/build_teacher_video_batch.mjs retry",
    "video:plan": "node scripts/media/plan_teacher_video_rollout.mjs",
    "video:canary": "node scripts/media/plan_teacher_video_rollout.mjs --family-validation unverified --group-by topic --max-items-per-cohort 1 --plan-json-path data/generated/video-batch/video-canary-matrix.json --plan-markdown-path data/generated/video-batch/video-canary-matrix.md",
    "video:family-state": "node scripts/media/video_family_verification_state.mjs",
    "video:rollout:verified": "node scripts/media/apply_verified_video_rollout.mjs --resume-existing",
    "video:workflow": "node scripts/media/run_video_workflow.mjs",
    "video:worker": "node scripts/media/video_batch_worker.mjs",
    "video:teacher-script": "node scripts/media/generate_teacher_video_script.mjs",
    "video:teacher-script:migrate": "node scripts/media/migrate_teacher_video_scripts.mjs",
    "verify:video": "node scripts/verify/check-video-pipeline.mjs",
    "build:web": "node scripts/bootstrap/patch-next-build.js && npm run build --workspace web",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.448"
  }
}
